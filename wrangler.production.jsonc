{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Eigenständige Produktionskonfiguration für den direkten Betrieb auf
  // Cloudflare Workers, unabhängig von der OpenAI-Sites-Hostingplattform
  // (siehe .openai/hosting.json und docs/cloudflare-self-hosting.md).
  //
  // wrangler.jsonc bleibt unverändert die lokale D1-Simulation für `npm run dev`.
  // Diese Datei gilt für den Produktionsbuild mit
  // JNSW_WRANGLER_CONFIG=wrangler.production.jsonc (Build-Trigger auf Branch `deploy`).
  "name": "jnsw-de",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jwx_db01",
      "database_id": "abdb3246-a9b0-4236-a838-186d4187bdf4",
      "migrations_dir": "drizzle",
    },
  ],
  // Cloudflare Email Service: Bestätigungs-E-Mails (app/mail.ts) gehen über dieses
  // Binding. Voraussetzung: jnsw.de ist unter Email Sending eingerichtet
  // (scripts/cloudflare-mail.mjs, docs/email-versand.md) und der Account hat Workers Paid.
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["service@jnsw.de"] }],
  // R2 ist auf diesem Account noch nicht aktiviert (Cloudflare verlangt eine
  // einmalige manuelle Bestätigung im Dashboard) und der bestehende Worker
  // `jnsw-de` hat aktuell kein R2-Binding. Sobald `APPLICATION_DOCUMENTS`
  // gebraucht wird (z. B. für die Bewerbungswerkstatt), hier ergänzen:
  // "r2_buckets": [{ "binding": "APPLICATION_DOCUMENTS", "bucket_name": "..." }],
  // Ausdrücklich gesetzt: Mit Einträgen unter `routes` schaltet Wrangler die
  // workers.dev-Adresse sonst beim Deploy ab.
  "workers_dev": true,
  "routes": [
    // Custom Domains: nur der Hostname, Pfade und Wildcards sind nicht erlaubt.
    { "pattern": "jnsw.de", "custom_domain": true },
    { "pattern": "www.jnsw.de", "custom_domain": true },
  ],
}
